{
  "name": "nora-open-generative-ai-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 38789",
    "build": "tailwindcss -c tailwind.config.cjs -i ../packages/studio/src/tailwind.css -o src/studio.generated.css --minify && vite build",
    "check": "node --check src/api.js && node --check src/catalog.js && node --check vite.config.js && npm run typecheck",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "axios": "^1.7.0",
    "react-icons": "^5.0.1",
    "lucide-react": "^0.487.0"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.24",
    "typescript": "^5.8.3"
  }
}
